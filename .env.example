# Django
SECRET_KEY=change-me-to-a-strong-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Frontend / CORS
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# E-mail transacional (senha de aplicativo/rede segura do provedor SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# PostgreSQL
# Configure DATABASE_URL com a URL interna do PostgreSQL no Render.
DATABASE_URL=

# Alternativa local quando DATABASE_URL estiver vazia:
DB_NAME=erp_vity
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Render production
RENDER_EXTERNAL_HOSTNAME=
SECURE_SSL_REDIRECT=False
